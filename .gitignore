# Environment / secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/

# Node
node_modules/
dist/
coverage/

# Hardhat build output
contracts/artifacts/
contracts/cache/

# Runtime data (never commit scanned artifacts or trained models)
workspace/
ml/data/*
!ml/data/.gitkeep
# Real-world manifest: public metadata only (identifiers, labels, licenses), tracked for reproducibility
!ml/data/realworld/
ml/models/*
!ml/models/.gitkeep

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Machine-specific Compose overrides (e.g. local DNS)
docker-compose.override.yml
