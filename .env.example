# ProvenanceX environment template. Copy to .env and adjust.
# Never commit .env. All values below are local-development placeholders.

# --- Core ---
APP_ENV=development
LOG_LEVEL=INFO
SCANNER_VERSION=0.1.0

# --- Database (matches docker-compose defaults; change the password locally) ---
POSTGRES_USER=provenancex
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=provenancex
# Host port Docker publishes Postgres on (127.0.0.1 only). On Windows/WSL2, a
# Windows PostgreSQL service may already hold 5432; set e.g. 5433 and use that
# port in DATABASE_URL below for host-side tools and tests.
POSTGRES_HOST_PORT=5432
DATABASE_URL=postgresql+psycopg://provenancex:change-me-local-only@localhost:5432/provenancex

# --- Ingestion limits (Phase 1) ---
WORKSPACE_ROOT=./workspace
# Max size of extracted/cloned content (also caps the git clone while it runs)
MAX_ARTIFACT_SIZE_MB=200
MAX_ARTIFACT_FILES=20000
# Max size of an uploaded ZIP
MAX_UPLOAD_MB=100
# Max uncompressed/compressed ratio per ZIP entry (decompression-bomb guard)
MAX_COMPRESSION_RATIO=100
GIT_CLONE_TIMEOUT_SECONDS=120

# --- Vulnerability intelligence (Phase 2) ---
OSV_API_BASE=https://api.osv.dev
NVD_API_KEY=

# --- Sandbox (Phase 4) ---
SANDBOX_TIMEOUT_SECONDS=60

# --- ML (Phase 5) ---
MODEL_PATH=./ml/models

# --- Blockchain (Phase 7) — local Hardhat dev network only ---
BLOCKCHAIN_RPC_URL=http://localhost:8545
BLOCKCHAIN_CONTRACT_ADDRESS=
# Use a Hardhat dev account key locally. Never put a real key here.
BLOCKCHAIN_PRIVATE_KEY=

# --- Frontend ---
CORS_ORIGINS=http://localhost:5173
