# ProvenanceX environment template. Copy to .env and adjust.
# Never commit .env. All values below are local-development placeholders.

# --- Core ---
APP_ENV=development
LOG_LEVEL=INFO
SCANNER_VERSION=0.1.0

# --- Database (matches docker-compose defaults; change the password locally) ---
POSTGRES_USER=provenancex
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=provenancex
# Host port Docker publishes Postgres on (127.0.0.1 only). On Windows/WSL2, a
# Windows PostgreSQL service may already hold 5432; set e.g. 5433 and use that
# port in DATABASE_URL below for host-side tools and tests.
POSTGRES_HOST_PORT=5432
DATABASE_URL=postgresql+psycopg://provenancex:change-me-local-only@localhost:5432/provenancex

# --- Ingestion limits (Phase 1) ---
WORKSPACE_ROOT=./workspace
# Max size of extracted/cloned content (also caps the git clone while it runs)
MAX_ARTIFACT_SIZE_MB=200
MAX_ARTIFACT_FILES=20000
# Max size of an uploaded ZIP
MAX_UPLOAD_MB=100
# Max uncompressed/compressed ratio per ZIP entry (decompression-bomb guard)
MAX_COMPRESSION_RATIO=100
GIT_CLONE_TIMEOUT_SECONDS=120

# --- SBOM (Phase 2) ---
# syft = real Syft CLI (default). mock = recorded fixture SBOM for every input, labeled
# source="mock". A missing Syft shows up as an "unavailable" stage; it never falls back to mock.
SBOM_PROVIDER=syft
SYFT_PATH=syft
SYFT_TIMEOUT_SECONDS=300
MAX_SBOM_MB=50
MAX_SBOM_COMPONENTS=50000

# --- Vulnerability intelligence (Phase 2) ---
# osv = live OSV API (default). mock = recorded OSV records, labeled source="mock".
VULN_PROVIDER=osv
OSV_API_BASE=https://api.osv.dev
OSV_TIMEOUT_SECONDS=20
OSV_MAX_DETAIL_LOOKUPS=500
# NVD is used only to add CVSS to advisories that OSV could not score.
NVD_ENABLED=true
NVD_API_BASE=https://services.nvd.nist.gov/rest/json/cves/2.0
# Optional. Raises the NVD rate limit (about 6s between requests without a key, 0.6s with one).
NVD_API_KEY=
NVD_TIMEOUT_SECONDS=20
NVD_MAX_LOOKUPS=10
HTTP_MAX_RETRIES=2
HTTP_MAX_RESPONSE_MB=10

# --- AI/model ingestion (Phase 3) ---
# hf = live Hugging Face Hub (default). mock = a synthetic fixture repo returned for every URL,
# labeled source="mock". No HF token is used, so only public, non-gated repositories can be scanned.
HF_PROVIDER=hf
HF_TIMEOUT_SECONDS=30
# Overall time budget for downloading one repository's files
HF_DOWNLOAD_TIMEOUT_SECONDS=600
# LFS files above this size are listed with the Hub-reported hash (unverified) but not downloaded.
# MAX_ARTIFACT_SIZE_MB caps the total download.
HF_MAX_FILE_MB=64
HF_MAX_FILES=2000
# Parse-only analysis limits
PICKLE_MAX_MB=64
PICKLE_MAX_OPCODES=2000000
MODEL_CARD_MAX_KB=256

# --- Static analysis (Phase 4, parse-only) ---
# When a budget is hit, the static stage is "partial" and lists what was not analyzed.
STATIC_MAX_FILES=5000
STATIC_MAX_FILE_KB=1024
STATIC_MAX_TOTAL_MB=64
STATIC_MAX_FINDINGS=500
# Research parameter: share of MAX_COMPRESSION_RATIO reported as "near the limit"
STATIC_ARCHIVE_RATIO_WARN_FRACTION=0.8

# --- Behavioral (dynamic) analysis sandbox (Phase 4) — optional evidence layer ---
# This is NOT the mandatory content-analysis sandbox (see ANALYZER_* below): with
# SANDBOX_PROVIDER=disabled no behavior is observed, but every content-reading step still runs
# in the analyzer container. disabled (default) | docker | mock. mock returns a synthetic bundle
# labeled source="mock", and is never a fallback. docker needs the scan runner on the host
# (make runner); the Compose runner does not support it yet.
# Build the image first: docker build -t provenancex-sandbox:0.1.0 docker/sandbox
SANDBOX_PROVIDER=disabled
SANDBOX_DOCKER_PATH=docker
SANDBOX_IMAGE=provenancex-sandbox:0.1.0
SANDBOX_TIMEOUT_SECONDS=60
SANDBOX_HOST_GRACE_SECONDS=15
SANDBOX_MEMORY_MB=512
SANDBOX_CPUS=1
SANDBOX_PIDS_LIMIT=128
SANDBOX_TMP_MB=64
SANDBOX_TRACE_TMP_MB=32
# Container stderr is capped too, because code in the container can write to it.
SANDBOX_MAX_STDERR_KB=1024
# Resource limits are per container; this caps how many run at once (per API process).
SANDBOX_MAX_CONCURRENT=2
SANDBOX_QUEUE_TIMEOUT_SECONDS=300
# Traces are untrusted, so the parser caps their size.
SANDBOX_MAX_TRACE_MB=16
SANDBOX_MAX_TRACE_LINES=200000
# Research parameters: resource_spike thresholds, as shares of the sandbox limits
SANDBOX_SPIKE_MEMORY_FRACTION=0.9
SANDBOX_SPIKE_PIDS_FRACTION=0.9
SANDBOX_SPIKE_CPU_FRACTION=0.9
SANDBOX_SPIKE_CPU_MIN_INTERVALS=3

# --- ML (Phase 6) ---
# Host runs only, relative to backend/. Docker Compose ignores this and uses the read-only
# mount of ./ml/models at /app/ml/models. Without trained models, risk falls back to rules and
# reports "ML model unavailable". Create them with ml/scripts/train_models.py.
MODEL_PATH=../ml/models

# --- Sandbox-only content analysis (docs/security/sandbox.md) ---
# Every step that reads untrusted artifact content runs in a disposable analyzer container:
# --network=none, read-only root, non-root, cap-drop ALL, no-new-privileges, memory/CPU/pids
# limits, noexec tmpfs, verified with `docker inspect` before start. There is NO disabled mode
# and no host fallback: without Docker and the image, scans fail with sandbox_unavailable.
# Build the image: make analyzer-image
ANALYZER_PROVIDER=docker
ANALYZER_DOCKER_PATH=docker
ANALYZER_IMAGE=provenancex-analyzer:0.1.0
ANALYZER_TIMEOUT_SECONDS=600
ANALYZER_EXTRACT_TIMEOUT_SECONDS=300
ANALYZER_HOST_GRACE_SECONDS=15
# tmpfs pages count toward the memory limit; keep it well above ANALYZER_TMP_MB.
ANALYZER_MEMORY_MB=1536
ANALYZER_CPUS=1.0
ANALYZER_PIDS_LIMIT=128
ANALYZER_TMP_MB=256
ANALYZER_MAX_OUTPUT_MB=96
ANALYZER_MAX_STDERR_KB=256
# bind: the runner runs on the host (make runner). volume: inside Compose (set there).
ANALYZER_WORKSPACE_MOUNT=bind
ANALYZER_WORKSPACE_VOLUME=provenancex_workspace
# Label value scoping orphan-container cleanup to this deployment (empty: the volume name).
ANALYZER_INSTANCE=
# Extra CPU seconds above ANALYZER_CPUS x time limit before the worker's RLIMIT_CPU stops it.
ANALYZER_CPU_GRACE_SECONDS=30
# runner: the API only queues and the scan-runner service runs scans (the only option outside
# the test suite).
SCAN_DISPATCH=runner
RUNNER_POLL_SECONDS=2.0
# Claim ownership: the runner renews a heartbeat every RUNNER_HEARTBEAT_SECONDS. A RUNNING scan
# whose heartbeat is silent for RUNNER_STALE_SECONDS (at least 3 heartbeats), or that was claimed
# more than RUNNER_MAX_SCAN_SECONDS ago, is failed and its claim replaced.
RUNNER_HEARTBEAT_SECONDS=10
RUNNER_STALE_SECONDS=120
RUNNER_MAX_SCAN_SECONDS=1800
RUNNER_RECONCILE_SECONDS=30
# Unique per runner replica. Empty: the hostname (the container id in Compose).
RUNNER_ID=
# Compose stop_grace_period for the runner: RUNNER_MAX_SCAN_SECONDS plus a minute.
RUNNER_STOP_GRACE_PERIOD=31m
# Group id that owns /var/run/docker.sock, for the Compose scan-runner: `stat -c %g
# /var/run/docker.sock` (make up and scripts/demo.sh detect it). A wrong value fails closed:
# scans fail with sandbox_unavailable ("no permission on the Docker socket").
DOCKER_SOCKET_GID=0

# --- Blockchain (Phase 7) — local Hardhat dev network only ---
# disabled (default), web3 (the local chain) or mock (in-memory, labeled source="mock").
BLOCKCHAIN_PROVIDER=disabled
# true anchors each completed scan automatically. Otherwise use POST /scans/{id}/anchor.
BLOCKCHAIN_ANCHOR_ON_SCAN=false
BLOCKCHAIN_TIMEOUT_SECONDS=30
# Host runs only. Compose always uses http://hardhat:8545. Only local hosts are accepted.
BLOCKCHAIN_RPC_URL=http://localhost:8545
# Host port for the Compose hardhat service (always bound to 127.0.0.1).
BLOCKCHAIN_HOST_PORT=8545
# Printed by the deploy step. See contracts/README.md.
BLOCKCHAIN_CONTRACT_ADDRESS=
# Set this in your git-ignored .env only. Use a test account printed by `docker compose logs
# hardhat`. Those keys are public. Never put a real key or one holding real funds here.
BLOCKCHAIN_PRIVATE_KEY=

# --- Frontend ---
CORS_ORIGINS=http://localhost:5173
