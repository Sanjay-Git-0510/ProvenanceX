# ProvenanceX environment template. Copy to .env and adjust.
# Never commit .env. All values below are local-development placeholders.

# --- Core ---
APP_ENV=development
LOG_LEVEL=INFO
SCANNER_VERSION=0.1.0

# --- Database (matches docker-compose defaults; change the password locally) ---
POSTGRES_USER=provenancex
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=provenancex
# Host port Docker publishes Postgres on (127.0.0.1 only). On Windows/WSL2, a
# Windows PostgreSQL service may already hold 5432; set e.g. 5433 and use that
# port in DATABASE_URL below for host-side tools and tests.
POSTGRES_HOST_PORT=5432
DATABASE_URL=postgresql+psycopg://provenancex:change-me-local-only@localhost:5432/provenancex

# --- Ingestion limits (Phase 1) ---
WORKSPACE_ROOT=./workspace
# Max size of extracted/cloned content (also caps the git clone while it runs)
MAX_ARTIFACT_SIZE_MB=200
MAX_ARTIFACT_FILES=20000
# Max size of an uploaded ZIP
MAX_UPLOAD_MB=100
# Max uncompressed/compressed ratio per ZIP entry (decompression-bomb guard)
MAX_COMPRESSION_RATIO=100
GIT_CLONE_TIMEOUT_SECONDS=120

# --- SBOM (Phase 2) ---
# syft = real Syft CLI (default). mock = recorded fixture SBOM for every input, labeled
# source="mock". A missing Syft shows up as an "unavailable" stage; it never falls back to mock.
SBOM_PROVIDER=syft
SYFT_PATH=syft
SYFT_TIMEOUT_SECONDS=300
MAX_SBOM_MB=50
MAX_SBOM_COMPONENTS=50000

# --- Vulnerability intelligence (Phase 2) ---
# osv = live OSV API (default). mock = recorded OSV records, labeled source="mock".
VULN_PROVIDER=osv
OSV_API_BASE=https://api.osv.dev
OSV_TIMEOUT_SECONDS=20
OSV_MAX_DETAIL_LOOKUPS=500
# NVD is used only to add CVSS to advisories that OSV could not score.
NVD_ENABLED=true
NVD_API_BASE=https://services.nvd.nist.gov/rest/json/cves/2.0
# Optional. Raises the NVD rate limit (about 6s between requests without a key, 0.6s with one).
NVD_API_KEY=
NVD_TIMEOUT_SECONDS=20
NVD_MAX_LOOKUPS=10
HTTP_MAX_RETRIES=2
HTTP_MAX_RESPONSE_MB=10

# --- AI/model ingestion (Phase 3) ---
# hf = live Hugging Face Hub (default). mock = a synthetic fixture repo returned for every URL,
# labeled source="mock". No HF token is used, so only public, non-gated repositories can be scanned.
HF_PROVIDER=hf
HF_TIMEOUT_SECONDS=30
# Overall time budget for downloading one repository's files
HF_DOWNLOAD_TIMEOUT_SECONDS=600
# LFS files above this size are listed with the Hub-reported hash (unverified) but not downloaded.
# MAX_ARTIFACT_SIZE_MB caps the total download.
HF_MAX_FILE_MB=64
HF_MAX_FILES=2000
# Parse-only analysis limits
PICKLE_MAX_MB=64
PICKLE_MAX_OPCODES=2000000
MODEL_CARD_MAX_KB=256

# --- Static analysis (Phase 4, parse-only) ---
# When a budget is hit, the static stage is "partial" and lists what was not analyzed.
STATIC_MAX_FILES=5000
STATIC_MAX_FILE_KB=1024
STATIC_MAX_TOTAL_MB=64
STATIC_MAX_FINDINGS=500
# Research parameter: share of MAX_COMPRESSION_RATIO reported as "near the limit"
STATIC_ARCHIVE_RATIO_WARN_FRACTION=0.8

# --- Sandbox (Phase 4) ---
# disabled (default) | docker | mock. mock returns a synthetic bundle labeled source="mock", and is
# never a fallback. docker needs the API running on the host with Docker; inside Compose the API has
# no Docker socket, so the stage reports "unavailable".
# Build the image first: docker build -t provenancex-sandbox:0.1.0 docker/sandbox
SANDBOX_PROVIDER=disabled
SANDBOX_DOCKER_PATH=docker
SANDBOX_IMAGE=provenancex-sandbox:0.1.0
SANDBOX_TIMEOUT_SECONDS=60
SANDBOX_HOST_GRACE_SECONDS=15
SANDBOX_MEMORY_MB=512
SANDBOX_CPUS=1
SANDBOX_PIDS_LIMIT=128
SANDBOX_TMP_MB=64
SANDBOX_TRACE_TMP_MB=32
# Container stderr is capped too, because code in the container can write to it.
SANDBOX_MAX_STDERR_KB=1024
# Resource limits are per container; this caps how many run at once (per API process).
SANDBOX_MAX_CONCURRENT=2
SANDBOX_QUEUE_TIMEOUT_SECONDS=300
# Traces are untrusted, so the parser caps their size.
SANDBOX_MAX_TRACE_MB=16
SANDBOX_MAX_TRACE_LINES=200000
# Research parameters: resource_spike thresholds, as shares of the sandbox limits
SANDBOX_SPIKE_MEMORY_FRACTION=0.9
SANDBOX_SPIKE_PIDS_FRACTION=0.9
SANDBOX_SPIKE_CPU_FRACTION=0.9
SANDBOX_SPIKE_CPU_MIN_INTERVALS=3

# --- ML (Phase 5) ---
MODEL_PATH=./ml/models

# --- Blockchain (Phase 7) — local Hardhat dev network only ---
BLOCKCHAIN_RPC_URL=http://localhost:8545
BLOCKCHAIN_CONTRACT_ADDRESS=
# Use a Hardhat dev account key locally. Never put a real key here.
BLOCKCHAIN_PRIVATE_KEY=

# --- Frontend ---
CORS_ORIGINS=http://localhost:5173
